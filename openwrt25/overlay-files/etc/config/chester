config display 'clients'
	list wired_interfaces 'br-lan'
	option filtermode 'blacklist'
	option temp_node 'modem'

config main 'main'
	option hwmon_node '/sys/class/hwmon/hwmon1'
	option temp_node 'modem'
	option fan_enabled '1'
	option fan_mode '1'
	option fan_temp_threshold '70'
	option apn_country 'unknown'
	option boost_cap '0'
	option boost_gpio ''
	option boost_mode 'auto'
	option boost_manual_value '0'

config wifi 'wifi_defaults'
	option linked_bands '1'

config network 'network_defaults'
	option wan_role 'wan'
	option wan_device ''
	option optional_wan ''
	option optional_wan_mode 'wan'

config modem 'modem_cfg_main'
	list hidden_lockband 'UMTS'

config wizard 'setup'
	option completed '1'
	option skipped_network '0'
	option skipped_wifi '0'
	option skipped_admin '0'
