#!/bin/sh /etc/rc.common
# See /usr/sbin/chester-phy-led for what this configures and why.
#
# procd runs it, rather than a bare "cmd &" or start-stop-daemon -b. Both of
# those were tried: the background job is killed when the init shell exits, and
# start-stop-daemon did not launch the script at all -- in each case the rc.d
# entry fired at boot and silently did nothing. procd detaches it properly and
# it is a one-shot, so no respawn is configured.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance phyled
	procd_set_param command /usr/sbin/chester-phy-led wan 60
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
