#!/bin/sh /etc/rc.common
# See /usr/sbin/chester-phy-led.
#
# procd runs it, rather than a bare "cmd &" or start-stop-daemon -b. Both
# were tried: a background job is killed when the init shell exits, and
# start-stop-daemon did not launch it at all -- in each case the rc.d entry
# fired at boot and silently did nothing.
#
# It stays running as a watchdog now, so respawn is set: if it is ever
# killed the socket would go dark with nothing to restore it.
START=99
USE_PROCD=1

start_service() {
	procd_open_instance phyled
	procd_set_param command /usr/sbin/chester-phy-led wan 60 30
	procd_set_param respawn 3600 10 0
	procd_set_param stdout 0
	procd_set_param stderr 1
	procd_close_instance
}
