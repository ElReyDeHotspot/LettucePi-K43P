#!/bin/sh /etc/rc.common
# Rewrites the TTL / hop limit of everything forwarded from the LAN, so the
# upstream carrier sees a single hop count instead of one per tethered device.
#
# Ported from luci-app-qmodem-ttlfw4. Two changes for this board:
#   - /etc/firewall.d/qmodem_ttl does not exist here, so calling it is guarded.
#   - the qca-nss / shortcut-fe unloads are Qualcomm-only and simply never
#     match on MT7981; they are kept guarded so the script stays portable.
START=95
STOP=13
USE_PROCD=1

. $IPKG_INSTROOT/usr/share/libubox/jshn.sh
. $IPKG_INSTROOT/lib/functions.sh

nftfile="/etc/nftables.d/99-reset-ttl-from-br-lan.nft"

start_service() {
	config_load 'qmodem_ttl'
	config_get enable 'main' 'enable' '0'
	[ "$enable" = "1" ] || { rm -f "$nftfile"; return 0; }
	set_if_ttl
}

set_if_ttl() {
	config_get ttl 'main' 'ttl' '64'
	case "$ttl" in
		''|*[!0-9]*) logger -t modem_ttl "refusing non-numeric ttl '$ttl'"; return 1 ;;
	esac
	[ "$ttl" -ge 1 ] && [ "$ttl" -le 255 ] || {
		logger -t modem_ttl "refusing out-of-range ttl '$ttl'"; return 1; }

	logger -t modem_ttl "Overwrite TTL from br-lan to $ttl"
	mkdir -p /etc/nftables.d
	cat <<EOF > "$nftfile"
chain postrouting {
    type filter hook postrouting priority mangle; policy accept;
    iifname "br-lan" ip ttl set $ttl comment "Reset TTL for br-lan IPv4"
    iifname "br-lan" ip6 hoplimit set $ttl comment "Reset Hop Limit for br-lan IPv6"
}

EOF
	[ -x /etc/firewall.d/qmodem_ttl ] && /etc/firewall.d/qmodem_ttl

	# Offloaded flows skip the mangle hook entirely, so the rewrite would apply
	# to the first packet only. Turn offloading off while TTL rewriting is on.
	[ -d /sys/kernel/debug/ecm/ ] && /etc/init.d/qca-nss-ecm stop
	[ -d /sys/module/shortcut_fe_cm ] && rmmod shortcut_fe_cm
	[ -d /sys/module/fast_classifier ] && rmmod fast_classifier
	# Remember what offloading was set to before we turn it off. Without
	# this, switching TTL on and then off again leaves the router with
	# hardware offload disabled for good -- a silent throughput loss the
	# user never asked for. Only record it once, so a second start does
	# not overwrite the real value with the zero we just wrote.
	if [ -z "$(uci -q get qmodem_ttl.main.saved_offload)" ]; then
		uci -q set qmodem_ttl.main.saved_offload="$(uci -q get firewall.@defaults[0].flow_offloading || echo 0)"
		uci -q set qmodem_ttl.main.saved_offload_hw="$(uci -q get firewall.@defaults[0].flow_offloading_hw || echo 0)"
		uci -q commit qmodem_ttl
	fi
	uci set firewall.@defaults[0].flow_offloading='0'
	uci set firewall.@defaults[0].flow_offloading_hw='0'
	uci commit firewall
	/etc/init.d/firewall restart
}

stop_service() {
	local kernel_version="$(uname -r)"
	rm -f "$nftfile"

	# Put offloading back the way we found it.
	saved="$(uci -q get qmodem_ttl.main.saved_offload)"
	if [ -n "$saved" ]; then
		uci set firewall.@defaults[0].flow_offloading="$saved"
		uci set firewall.@defaults[0].flow_offloading_hw="$(uci -q get qmodem_ttl.main.saved_offload_hw || echo 0)"
		uci commit firewall
		uci -q delete qmodem_ttl.main.saved_offload
		uci -q delete qmodem_ttl.main.saved_offload_hw
		uci -q commit qmodem_ttl
	fi
	[ -f /etc/init.d/qca-nss-ecm ] && /etc/init.d/qca-nss-ecm start
	[ -e "/lib/modules/$kernel_version/shortcut-fe-cm.ko" ] && modprobe shortcut-fe-cm
	[ -e "/lib/modules/$kernel_version/fast-classifier.ko" ] && modprobe fast-classifier
	/etc/init.d/firewall restart
}

service_triggers() {
	procd_add_reload_trigger "qmodem_ttl"
}

reload_service() {
	stop
	start
}
