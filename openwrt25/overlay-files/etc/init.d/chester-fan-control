#!/bin/sh /etc/rc.common

USE_PROCD=1
START=99

LOG_TAG="chester-fan-control"
HWMON_PREFIX="/sys/class/hwmon/"
MONITOR_BIN="/usr/bin/chester-fan-monitor"

normalize_mode() {
	local mode enabled

	mode="$(uci -q get chester.main.fan_mode)"
	case "$mode" in
		0|1|2)
			printf '%s\n' "$mode"
			return 0
			;;
	esac

	enabled="$(uci -q get chester.main.fan_enabled)"
	case "$enabled" in
		0|false|off|disabled)
			printf '0\n'
			;;
		*)
			printf '1\n'
			;;
	esac
}

get_hwmon_target() {
	local hwmon_node

	hwmon_node="$(uci -q get chester.main.hwmon_node)"
	hwmon_node="${hwmon_node%/}"

	[ -n "$hwmon_node" ] || return 1

	case "$hwmon_node" in
		"${HWMON_PREFIX}"*)
			printf '%s/pwm1_enable\n' "$hwmon_node"
			return 0
			;;
		*)
			logger -t "$LOG_TAG" "ignoring invalid hwmon node: $hwmon_node"
			return 1
			;;
	esac
}

write_pwm_value() {
	local target value

	target="$1"
	value="$2"

	if [ ! -e "$target" ]; then
		logger -t "$LOG_TAG" "target does not exist: $target"
		return 0
	fi

	if [ ! -w "$target" ]; then
		logger -t "$LOG_TAG" "target is not writable: $target"
		return 0
	fi

	if ! printf '%s\n' "$value" > "$target"; then
		logger -t "$LOG_TAG" "failed to write pwm value $value to: $target"
	fi

	return 0
}

write_pwm_duty() {
	local target duty_node

	target="$1"
	duty_node="${target%_enable}"

	[ "$duty_node" != "$target" ] || return 0
	[ -w "$duty_node" ] || return 0

	if ! printf '100\n' > "$duty_node"; then
		logger -t "$LOG_TAG" "failed to write pwm duty 100 to: $duty_node"
	fi

	return 0
}

apply_direct_mode() {
	local mode target value

	mode="$(normalize_mode)"
	target="$(get_hwmon_target)" || return 0
	value="1"

	case "$mode" in
		0)
			value="0"
			;;
	esac

	if [ "$value" = "1" ]; then
		write_pwm_duty "$target"
	fi

	write_pwm_value "$target" "$value"
}

start_monitor_instance() {
	if [ ! -x "$MONITOR_BIN" ]; then
		logger -t "$LOG_TAG" "monitor binary is not executable: $MONITOR_BIN"
		return 0
	fi

	procd_open_instance
	procd_set_param command "$MONITOR_BIN" 5 2
	procd_set_param respawn 3600 5 5
	procd_close_instance
}

start_service() {
	local mode

	mode="$(normalize_mode)"
	case "$mode" in
		2)
			start_monitor_instance
			;;
		*)
			apply_direct_mode
			;;
	esac
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger "chester"
}
