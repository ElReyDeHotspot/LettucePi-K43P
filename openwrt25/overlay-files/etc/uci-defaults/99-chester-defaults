#!/bin/sh
# Keep the product's address and login so a unit stays reachable across the
# move from the ImmortalWrt build. Stock OpenWrt would come up on
# 192.168.1.1 with no root password.
uci -q set network.lan.ipaddr='192.168.100.1'
uci -q set network.lan.netmask='255.255.255.0'
uci -q commit network

# Same hash the ImmortalWrt build ships (password: admin). Generated with
# busybox passwd on the target, so the $5$ SHA-256 format is what this
# firmware produces.
sed -i 's|^root:[^:]*:|root:$5$MvnJarVIBlXg2KtV$jXgqH2st5Bs.hA8rY3m3p8l0VQ15xSWS95CiHqPjsYB:|' /etc/shadow

uci -q set system.@system[0].hostname='ChesterK43P'
uci -q commit system

# Wi-Fi regulatory domain: stock defaults are not US.
[ -f /etc/config/wireless ] || wifi config
for r in $(uci show wireless 2>/dev/null | sed -n 's/^wireless\.\([a-z0-9]*\)=wifi-device$/\1/p'); do
	uci -q set wireless.$r.country='US'
	uci -q set wireless.$r.disabled='0'
done
uci -q commit wireless

# Vendor name from the upstream board profile: the device tree model is already
# "Chester K43P", but board.json and the release strings still say AlwayLink.
[ -f /etc/board.json ] && sed -i 's/"AlwayLink[^"]*"/"Chester K43P"/g; s/AlwayLink/Chester/g' /etc/board.json
# Stock ships these as "Generic", not "AlwayLink", so a rename never matched.
# Set them outright. The compatible string (alwaylink,m01k43) is deliberately
# left alone: board.d, QModem detection and sysupgrade all match on it.
for f in /etc/device_info /usr/lib/os-release /etc/os-release; do
	[ -f "$f" ] || continue
	sed -i "s|^DEVICE_MANUFACTURER=.*|DEVICE_MANUFACTURER='Chester'|" "$f"
	sed -i "s|^DEVICE_PRODUCT=.*|DEVICE_PRODUCT='Chester K43P'|" "$f"
	sed -i 's|^OPENWRT_DEVICE_MANUFACTURER=.*|OPENWRT_DEVICE_MANUFACTURER="Chester"|' "$f"
	sed -i 's|^OPENWRT_DEVICE_PRODUCT=.*|OPENWRT_DEVICE_PRODUCT="Chester K43P"|' "$f"
	sed -i 's/AlwayLink/Chester/g' "$f"
done

# QModem port scanning. enable_pcie_scan ships set, but enable_usb_scan is not
# present at all, so its box renders unchecked and a USB modem is never found.
# Set both so either bus works out of the box.
uci -q set qmodem.main.enable_pcie_scan='1'
uci -q set qmodem.main.enable_usb_scan='1'
uci -q commit qmodem

exit 0
