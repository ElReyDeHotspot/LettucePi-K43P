#!/bin/sh

. /usr/share/libubox/jshn.sh

DEFAULT_LAN_IP='192.168.100.1'
DEFAULT_HOSTNAME='5G_CPE'
DEFAULT_WIFI_SSID='5G_CPE'
DEFAULT_WIFI_KEY='123456789'
DEFAULT_APN_COUNTRY='us'
APN_PRESET_DEFAULT_DIR='/usr/share/chester/apn-presets/defaults'
APN_PRESET_USER_DIR='/etc/chester/apn-presets'

trim_value() {
	echo "$1" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//'
}

read_uboot_env() {
	local key="$1"
	local value=''

	command -v fw_printenv >/dev/null 2>&1 || return 0

	value="$(fw_printenv -n "$key" 2>/dev/null)"

	if [ -z "$value" ]; then
		value="$(fw_printenv "$key" 2>/dev/null | sed -n "s/^${key}=//p" | head -n 1)"
	fi

	trim_value "$value"
}

ensure_oem_state_config() {
	if ! uci -q get chester_oem.state >/dev/null 2>&1; then
		uci -q batch <<-EOF
			set chester_oem.state=state
			set chester_oem.state.initialized='0'
		EOF
		uci commit chester_oem
	fi
}

is_oem_initialized() {
	[ "$(uci -q get chester_oem.state.initialized)" = '1' ]
}

mark_oem_initialized() {
	uci -q set chester_oem.state.initialized='1'
	uci commit chester_oem
}

find_system_section() {
	uci -q show system 2>/dev/null | sed -n 's/^system\.\([^.=]*\)=system$/\1/p' | head -n 1
}

ensure_system_config() {
	local section

	section="$(find_system_section)"

	if [ -z "$section" ]; then
		uci -q add system system >/dev/null 2>&1 || true
	fi
}

configure_system_defaults() {
	local section
	local hostname

	ensure_system_config

	section="$(find_system_section)"
	[ -n "$section" ] || return 0

	hostname="$(read_uboot_env hostname)"

	[ -n "$hostname" ] || hostname="$DEFAULT_HOSTNAME"

	uci -q set "system.${section}.hostname=${hostname}"
	uci commit system
}

ensure_lan_config() {
	if ! uci -q show network.lan >/dev/null 2>&1; then
		uci -q batch <<-EOF
			set network.lan=interface
			set network.lan.proto='static'
			set network.lan.device='br-lan'
			set network.lan.netmask='255.255.255.0'
		EOF
	fi

	uci -q set network.lan.ipaddr="${DEFAULT_LAN_IP}"

	if [ -z "$(uci -q get network.lan.proto)" ]; then
		uci -q set network.lan.proto='static'
	fi

	if [ -z "$(uci -q get network.lan.netmask)" ]; then
		uci -q set network.lan.netmask='255.255.255.0'
	fi

	uci commit network
}

configure_dropbear() {
	local section

	section="$(uci -q show dropbear 2>/dev/null | sed -n 's/^dropbear\.\([^.=]*\)=dropbear$/\1/p' | head -n 1)"

	if [ -z "${section}" ]; then
		section="$(uci add dropbear dropbear 2>/dev/null)"
	fi

	if [ -n "${section}" ]; then
		uci -q batch <<-EOF
			set dropbear.${section}.PasswordAuth='on'
			set dropbear.${section}.RootPasswordAuth='on'
		EOF
		uci commit dropbear
	fi

	/etc/init.d/dropbear enable >/dev/null 2>&1 || true
	/etc/init.d/dropbear restart >/dev/null 2>&1 || true
}

find_wifi_iface_sections() {
	uci -q show wireless 2>/dev/null | sed -n 's/^wireless\.\([^.=]*\)=wifi-iface$/\1/p'
}

configure_wifi_defaults() {
	local ssid
	local key
	local section
	local mode

	ssid="$(read_uboot_env chester_ssid)"
	key="$(read_uboot_env chester_key)"

	[ -n "$ssid" ] || ssid="$DEFAULT_WIFI_SSID"
	[ -n "$key" ] || key="$DEFAULT_WIFI_KEY"

	for section in $(find_wifi_iface_sections); do
		mode="$(uci -q get "wireless.${section}.mode")"
		[ -z "$mode" ] || [ "$mode" = 'ap' ] || continue

		uci -q set "wireless.${section}.ssid=${ssid}"
		uci -q set "wireless.${section}.encryption=psk2"
		uci -q set "wireless.${section}.key=${key}"
	done

	uci commit wireless
	wifi reload >/dev/null 2>&1 || true
}

configure_apn_country() {
	local country
	local country_lc
	local source_file

	country="$(read_uboot_env owrt_country)"
	[ -n "$country" ] || country="$DEFAULT_APN_COUNTRY"
	country_lc="$(echo "$country" | tr 'A-Z' 'a-z')"

	case "$country_lc" in
	*[!a-z0-9_-]*|'')
		country_lc="$DEFAULT_APN_COUNTRY"
		;;
	esac

	uci -q set chester.main=main
	uci -q set "chester.main.apn_country=${country_lc}"
	uci commit chester

	mkdir -p "$APN_PRESET_USER_DIR"
	source_file="${APN_PRESET_DEFAULT_DIR}/${country_lc}.json"
	[ -f "$source_file" ] || source_file="${APN_PRESET_DEFAULT_DIR}/${DEFAULT_APN_COUNTRY}.json"
	[ -f "$source_file" ] && cp -f "$source_file" "${APN_PRESET_USER_DIR}/${country_lc}.json"
}

configure_board_network_defaults() {
	local wan_role
	local wan_device
	local optional_wan
	local optional_wan_mode

	json_load_file /etc/board.json 2>/dev/null || return 0
	json_select chester 2>/dev/null || return 0
	json_select network_defaults 2>/dev/null || return 0
	json_get_vars wan_role wan_device optional_wan optional_wan_mode
	json_select ..
	json_select ..

	[ -n "$wan_role" ] || return 0

	uci -q set chester.network_defaults=network
	uci -q set "chester.network_defaults.wan_role=${wan_role}"

	if [ -n "$wan_device" ]; then
		uci -q set "chester.network_defaults.wan_device=${wan_device}"
	fi

	if [ -n "$optional_wan" ]; then
		uci -q set "chester.network_defaults.optional_wan=${optional_wan}"
	fi

	if [ -n "$optional_wan_mode" ]; then
		uci -q set "chester.network_defaults.optional_wan_mode=${optional_wan_mode}"
	fi

	uci commit chester
}

ensure_oem_state_config

if is_oem_initialized; then
	exit 0
fi

configure_system_defaults
configure_apn_country
configure_board_network_defaults
ensure_lan_config
configure_wifi_defaults
configure_dropbear
mark_oem_initialized

exit 0
