#!/bin/sh
# Light the 2.5G WAN socket.
#
# That socket is driven by an external Realtek RTL8221B rather than by the
# MT7531, so the switch driver does not configure its LEDs the way it does for
# the four LAN sockets. ImmortalWrt sets them from the device tree through
# realtek,led-link-select and realtek,led-act-select; upstream OpenWrt's realtek
# driver implements neither property, so the socket simply stays dark.
#
# The register addresses were not guessed. The same PHY was dumped under both
# firmwares and the dumps diffed: exactly these registers came back holding the
# constants the vendor device tree specifies.
#
#   0xd032 0xd034 0xd036 = 0x00a7   <- realtek,led-link-select = <0xa7 0xa7 0xa7>
#   0xd040               = 0x3515   <- realtek,led-act-select  = <0x3515>
#
# 0xd030 differs too (0xcccc vs 0x5555) but will not accept a write, and the
# LEDs work without it, so it is left alone.
#
# Two behaviours to be careful of:
#   - The PHY is not attached yet when this runs at boot; the switch reports
#     "configuring for phy/2500base-x" several seconds later. So the identity
#     check is retried rather than trusted once.
#   - A write does not always take. Each register is therefore written, read
#     back, and retried until it holds. Once set the values survive link and
#     interface cycling, so this settles quickly and stays settled.

PHY_IFACE="${1:-wan}"
PHY_ADDR=6
TRIES="${2:-60}"
WRITE_TRIES=8

command -v phytool >/dev/null 2>&1 || exit 0

phy_get() { phytool read "$PHY_IFACE/$PHY_ADDR:31/$1" 2>/dev/null; }
phy_set() {
	reg="$1"; val="$2"; n=0
	while [ "$n" -lt "$WRITE_TRIES" ]; do
		[ "$(phy_get "$reg")" = "$val" ] && return 0
		phytool write "$PHY_IFACE/$PHY_ADDR:31/$reg" "$val" 2>/dev/null
		n=$((n+1))
		sleep 1
	done
	[ "$(phy_get "$reg")" = "$val" ]
}

n=0
while [ "$n" -lt "$TRIES" ]; do
	if [ -d "/sys/class/net/$PHY_IFACE" ]; then
		# Only touch a PHY we recognise: Realtek OUI 0x001c, model 0xc849.
		hi=$(phytool read "$PHY_IFACE/$PHY_ADDR:1/0x0002" 2>/dev/null)
		lo=$(phytool read "$PHY_IFACE/$PHY_ADDR:1/0x0003" 2>/dev/null)
		if [ "$hi" = "0x001c" ] && [ "$lo" = "0xc849" ]; then
			bad=0
			phy_set 0xd032 0x00a7 || bad=1
			phy_set 0xd034 0x00a7 || bad=1
			phy_set 0xd036 0x00a7 || bad=1
			phy_set 0xd040 0x3515 || bad=1
			if [ "$bad" = 0 ]; then
				logger -t chester-phy-led "RTL8221B LEDs configured on $PHY_IFACE after ${n}s"
			else
				logger -t chester-phy-led "RTL8221B LEDs only partly configured on $PHY_IFACE: 0xd032=$(phy_get 0xd032) 0xd034=$(phy_get 0xd034) 0xd036=$(phy_get 0xd036) 0xd040=$(phy_get 0xd040)"
			fi
			exit 0
		fi
	fi
	n=$((n+1))
	sleep 1
done
logger -t chester-phy-led "gave up: no RTL8221B on $PHY_IFACE after ${TRIES}s"
exit 0
