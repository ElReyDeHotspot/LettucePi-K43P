#!/bin/sh
# Route every AT consumer through ubus-at-daemon.
#
# Without use_ubus each caller opens /dev/mhi_DUN directly. There is one port
# and several consumers -- the dashboard, the cellular pages, QModem's own
# services and the LED script -- so they queue on it. Observed on this board:
# eight tom_modem processes stuck on the port at once, the SIM reported as
# "miss" when it was present and ready, empty signal reads, and a dashboard
# showing stale values. With the daemon in front, access is serialised and the
# pile-up does not happen.
#
# The modem sections do not exist until QModem has scanned, which is after this
# point in the boot, so the section list is retried rather than read once.

TRIES="${1:-60}"
n=0

while [ "$n" -lt "$TRIES" ]; do
	sections="$(uci -q show qmodem 2>/dev/null | sed -n 's/^qmodem\.\([^.=]*\)=modem-device$/\1/p')"
	if [ -n "$sections" ]; then
		changed=0
		for s in $sections; do
			[ "$(uci -q get "qmodem.$s.use_ubus")" = "1" ] && continue
			uci -q set "qmodem.$s.use_ubus=1"
			changed=1
		done
		if [ "$changed" = 1 ]; then
			uci -q commit qmodem
			logger -t chester-at-serialize "AT access routed through ubus-at-daemon"
		fi
		exit 0
	fi
	n=$((n+1))
	sleep 1
done
logger -t chester-at-serialize "gave up: no modem section after ${TRIES}s"
exit 0
