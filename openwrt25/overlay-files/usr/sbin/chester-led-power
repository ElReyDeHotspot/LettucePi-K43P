#!/bin/sh
# Apply the saved front-panel light setting at boot.
#
# set_led_power writes chester.main.led_power, but the services that own
# the LEDs start fresh on every boot and would light them again. Absent
# means on, so a router that has never been told otherwise behaves the way
# it always did.

state="$(uci -q get chester.main.led_power)"
[ "$state" = "0" ] || exit 0

# Give the LED services time to come up, otherwise they light the panel
# again after this has run.
sleep 25
/etc/init.d/qmodem_led stop >/dev/null 2>&1
for l in /sys/class/leds/*; do
	echo none > "$l/trigger" 2>/dev/null
	echo 0 > "$l/brightness" 2>/dev/null
done
logger -t chester-led-power "front panel lights left off by saved setting"
exit 0
