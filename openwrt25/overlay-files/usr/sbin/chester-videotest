#!/bin/sh
# Video-path throughput test, and the A/B that proves the engine is doing something.
#
# Measures against Netflix's CDN (fast.com), NOT a generic speedtest host. That
# is the whole point: carriers throttle by recognising video, so a plain
# speedtest runs at full speed while video is capped. Comparing the video path
# against a non-video control is what exposes the cap.
#
#   chester-videotest both       -> one measurement, JSON
#   chester-videotest ab-start   -> begin an A/B run in the background
#   chester-videotest ab-status  -> progress, then the result
#
# The A/B takes about a minute (it has to stop the engine, measure, start it
# again, measure), which is far longer than an rpcd call may block. So it runs
# detached and the UI polls ab-status.
set -u

FAST_TOKEN=YXNkZmFzZGxmbnNkYWZoYXNkZmhrYWxm
FAST_API="https://api.fast.com/netflix/speedtest/v2?https=true&token=$FAST_TOKEN&urlCount=3"
CTRL_URL="https://speed.cloudflare.com/__down?bytes=25000000"
SECS=8

AB_OUT=/tmp/chester-abtest.json
AB_PROG=/tmp/chester-abtest.progress
AB_PID=/tmp/chester-abtest.pid

ENGINE=/opt/zapret/nfq/nfqws
INIT=/etc/init.d/zapret

have() { command -v "$1" >/dev/null 2>&1; }
have curl || { echo '{"ok":false,"error":"curl is not installed"}'; exit 1; }

engine_present() { [ -x "$ENGINE" ]; }
engine_running() { pgrep nfqws >/dev/null 2>&1; }

measure() {
	rate=$(curl -sS -o /dev/null --max-time "$SECS" \
		--write-out '%{speed_download}' "$1" 2>/dev/null)
	[ -n "$rate" ] || { echo 0; return; }
	echo "$rate" | awk '{ printf "%.1f", ($1 * 8) / 1000000 }'
}

video_urls() {
	curl -sS --max-time 15 "$FAST_API" 2>/dev/null \
		| tr ',' '\n' | sed -n 's/.*"url":"\([^"]*\)".*/\1/p' | head -3
}

# Best of three CDN nodes: one slow node should not read as throttling.
video_test() {
	urls=$(video_urls)
	[ -n "$urls" ] || { echo 0; return; }
	best=0
	for u in $urls; do
		r=$(measure "$u")
		best=$(awk -v a="$best" -v b="$r" 'BEGIN{print (b>a)?b:a}')
	done
	echo "$best"
}

verdict_of() {
	awk -v v="$1" -v c="$2" 'BEGIN{
		if (c < 2)       { print "inconclusive"; exit }
		if (v < 1)       { print "video-blocked"; exit }
		if (v < c * 0.6) { print "throttled"; exit }
		print "unthrottled"
	}'
}

progress() { echo "$1" > "$AB_PROG" 2>/dev/null; }

# ---------------------------------------------------------------- the A/B run
ab_run() {
	was_running=no
	engine_running && was_running=yes

	progress "Stopping the engine"
	"$INIT" stop >/dev/null 2>&1
	sleep 4

	progress "Measuring without the engine"
	off_v=$(video_test)
	off_c=$(measure "$CTRL_URL")

	progress "Starting the engine"
	"$INIT" start >/dev/null 2>&1
	sleep 6

	progress "Measuring with the engine"
	on_v=$(video_test)
	on_c=$(measure "$CTRL_URL")

	# Leave the engine as we found it.
	if [ "$was_running" = no ]; then
		"$INIT" stop >/dev/null 2>&1
	fi

	gain=$(awk -v a="$off_v" -v b="$on_v" 'BEGIN{
		if (a <= 0) { print 0; exit } printf "%.1f", b / a }')
	helped=$(awk -v a="$off_v" -v b="$on_v" 'BEGIN{
		print (b > a * 1.5) ? "true" : "false" }')

	cat > "$AB_OUT" <<EOF
{"ok":true,"done":true,
 "off":{"video_mbps":$off_v,"control_mbps":$off_c,"verdict":"$(verdict_of "$off_v" "$off_c")"},
 "on":{"video_mbps":$on_v,"control_mbps":$on_c,"verdict":"$(verdict_of "$on_v" "$on_c")"},
 "gain":$gain,"helped":$helped,"restored":"$was_running"}
EOF
	rm -f "$AB_PROG" "$AB_PID"
}

case "${1:-both}" in
video)
	printf '{"ok":true,"video_mbps":%s}\n' "$(video_test)"
	;;
control)
	printf '{"ok":true,"control_mbps":%s}\n' "$(measure "$CTRL_URL")"
	;;
both)
	v=$(video_test); c=$(measure "$CTRL_URL")
	engine=off
	engine_present && engine_running && engine=on
	printf '{"ok":true,"video_mbps":%s,"control_mbps":%s,"verdict":"%s","engine":"%s"}\n' \
		"$v" "$c" "$(verdict_of "$v" "$c")" "$engine"
	;;
ab-start)
	if [ -f "$AB_PID" ] && kill -0 "$(cat "$AB_PID" 2>/dev/null)" 2>/dev/null; then
		echo '{"ok":true,"started":false,"running":true}'; exit 0
	fi
	engine_present || { echo '{"ok":false,"error":"the 4K/HD engine is not installed"}'; exit 0; }
	rm -f "$AB_OUT" "$AB_PROG"
	progress "Starting"
	# setsid so the run survives the rpcd call returning
	setsid "$0" ab-run >/dev/null 2>&1 &
	echo $! > "$AB_PID"
	echo '{"ok":true,"started":true,"running":true}'
	;;
ab-run)
	ab_run
	;;
ab-status)
	if [ -f "$AB_OUT" ]; then
		cat "$AB_OUT"
	elif [ -f "$AB_PROG" ]; then
		printf '{"ok":true,"done":false,"running":true,"stage":"%s"}\n' "$(cat "$AB_PROG")"
	else
		echo '{"ok":true,"done":false,"running":false}'
	fi
	;;
*)
	echo "usage: chester-videotest both|ab-start|ab-status" >&2; exit 2 ;;
esac
