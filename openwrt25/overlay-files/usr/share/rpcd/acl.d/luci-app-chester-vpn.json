{
	"luci-app-chester-vpn": {
		"description": "Grant access to Chester VPN management",
		"read": {
			"file": {
				"/etc/chester-vpn": [ "list" ],
				"/etc/chester-vpn/*": [ "list", "read", "stat" ]
			},
			"ubus": {
				"file": [ "list", "read", "stat" ],
				"network.device": [ "status" ],
				"network.interface": [ "dump" ],
				"luci.chester.vpn": [ "syncFirewall" ]
			},
			"uci": [ "network", "firewall", "chester" ]
		},
		"write": {
			"file": {
				"/etc/chester-vpn": [ "write" ],
				"/etc/chester-vpn/*": [ "write", "remove" ]
			},
			"ubus": {
				"cgi-io": [ "upload" ],
				"file": [ "write", "remove" ],
				"luci.chester.vpn": [ "generateKeyPair", "getPublicKey", "generatePsk", "syncFirewall" ]
			},
			"uci": [ "network", "firewall", "chester" ]
		}
	}
}
