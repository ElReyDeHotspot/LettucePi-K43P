#!/usr/bin/ucode
'use strict';

import { popen } from 'fs';

function quoteArg(value) {
	return `'${replace(value, "'", "'\\''")}'`;
}

function trimSafe(value) {
	return trim(value || '');
}

function parseInteger(value, fallback) {
	let matches = match(trimSafe(value), /^-?\d+$/);

	if (!matches)
		return fallback;

	let parsed = +matches[0];
	return type(parsed) == 'int' ? parsed : fallback;
}

function readCommandOutput(command) {
	let fd = popen(`sh -c ${quoteArg(command)}`, 'r');

	if (!fd)
		return null;

	let output = trimSafe(fd.read('all') || '');
	fd.close();

	return output || null;
}

function runCommand(command) {
	let fd = popen(`sh -c ${quoteArg(`${command}; rc=$?; echo $rc`)}`, 'r');

	if (!fd) {
		return {
			result: false,
			code: -1
		};
	}

	let output = fd.read('all') || '';
	fd.close();

	let code = parseInteger(output, -1);

	return {
		result: code === 0,
		code: code
	};
}

function parseJsonSafe(value, fallback) {
	if (!value)
		return fallback;

	try {
		let parsed = json(value);
		return parsed != null ? parsed : fallback;
	}
	catch (err) {
		return fallback;
	}
}

function parseCpinStatus(output) {
	let raw = `${output || ''}`;
	let normalized = lc(raw);

	if (!normalized)
		return {
			present: false,
			status: ''
		};

	if (index(normalized, 'ready') >= 0)
		return {
			present: true,
			status: 'ready'
		};

	if (index(normalized, 'sim puk') >= 0)
		return {
			present: true,
			status: 'SIM PUK'
		};

	if (index(normalized, 'sim pin') >= 0)
		return {
			present: true,
			status: 'SIM PIN'
		};

	if (index(normalized, 'cme error') >= 0 || index(normalized, 'error') >= 0)
		return {
			present: false,
			status: 'No SIM card'
		};

	return {
		present: false,
		status: ''
	};
}

function readCpinInfo(section) {
	let atPort = trimSafe(readCommandOutput(`uci -q get qmodem.${section}.at_port 2>/dev/null`));

	if (!atPort)
		return {
			present: false,
			status: ''
		};

	return parseCpinStatus(readCommandOutput(`/usr/bin/tom_modem -d ${quoteArg(atPort)} -o a -c ${quoteArg('AT+CPIN?')}`));
}

function normalizeDevicePath(value) {
	return replace(trimSafe(value), /\/+$/, '');
}

function isModemAvailable(section) {
	let modemPath = normalizeDevicePath(readCommandOutput(`uci -q get qmodem.${section}.path 2>/dev/null`));

	return !modemPath || runCommand(`[ -e ${quoteArg(modemPath)} ]`).result;
}

function listNetworkInterfacesForModem(section) {
	let interfaces = [];
	let output = readCommandOutput(`uci -q show network 2>/dev/null`);

	if (!output)
		return interfaces;

	for (let line in split(output, /\n+/)) {
		let matchLine = match(line, /^network\.([^.=]+)\.modem_config='?([^']*)'?$/);

		if (matchLine && matchLine[2] == section)
			push(interfaces, matchLine[1]);
	}

	return interfaces;
}

function interfaceHasAddress(info) {
	return length(info?.['ipv4-address'] || []) > 0 || length(info?.['ipv6-address'] || []) > 0;
}

function readConnectStatus(section) {
	let names = listNetworkInterfacesForModem(section);
	let dump = parseJsonSafe(readCommandOutput(`ubus -S call network.interface dump 2>/dev/null`), {});

	for (let iface in (dump?.interface || [])) {
		if (index(names, iface?.interface) < 0)
			continue;

		if (iface?.up === true && interfaceHasAddress(iface))
			return { connection_status: 'Yes' };
	}

	return { connection_status: 'No' };
}

function setupCompleted() {
	return readCommandOutput(`uci -q get chester.setup.completed 2>/dev/null`) == '1';
}

function setupForbiddenResult() {
	return {
		result: false,
		code: 403,
		message: 'setup wizard is no longer available'
	};
}

function persistWizardState(completed, skippedNetwork, skippedWifi, skippedAdmin) {
	if (setupCompleted())
		return setupForbiddenResult();

	let result = runCommand(
		`uci -q set chester.setup=wizard && ` +
		`uci -q set chester.setup.completed=${quoteArg(completed ? '1' : '0')} && ` +
		`uci -q set chester.setup.skipped_network=${quoteArg(skippedNetwork ? '1' : '0')} && ` +
		`uci -q set chester.setup.skipped_wifi=${quoteArg(skippedWifi ? '1' : '0')} && ` +
		`uci -q set chester.setup.skipped_admin=${quoteArg(skippedAdmin ? '1' : '0')} && ` +
		`uci -q commit chester`
	);

	return {
		result: result.result,
		code: result.code,
		completed: completed ? '1' : '0',
		skipped_network: skippedNetwork ? '1' : '0',
		skipped_wifi: skippedWifi ? '1' : '0',
		skipped_admin: skippedAdmin ? '1' : '0',
		message: result.result ? null : 'failed to persist setup wizard state'
	};
}

function validProtocol(value) {
	return index([ 'dhcp', 'pppoe', 'static' ], value) >= 0;
}

function validEncryption(value) {
	return index([ 'none', 'open', 'psk2', 'sae', 'sae-mixed' ], value) >= 0;
}

function normalizeListValue(value) {
	if (type(value) == 'array')
		return value;

	if (type(value) == 'string') {
		let trimmed = trimSafe(value);
		return trimmed ? [ trimmed ] : [];
	}

	if (value == null)
		return [];

	return [ value ];
}

function prefixToNetmask(prefix) {
	let prefixLength = +prefix;

	if (type(prefixLength) != 'int' || prefixLength < 0 || prefixLength > 32)
		return '';

	let octets = [];
	let bits = prefixLength;

	for (let i = 0; i < 4; i++) {
		let size = bits < 0 ? 0 : (bits > 8 ? 8 : bits);
		push(octets, size ? `${(0xff << (8 - size)) & 0xff}` : '0');
		bits -= size;
	}

	return join('.', octets);
}

function parseIpv4Value(value) {
	let entries = normalizeListValue(value);
	let raw = '';

	for (let entry in entries) {
		let candidate = trimSafe(entry);
		if (candidate) {
			raw = candidate;
			break;
		}
	}

	let ipMatch = match(raw, /^([^\/]+)(\/(\d{1,2}))?$/);

	if (!ipMatch) {
		return {
			address: raw,
			netmask: ''
		};
	}

	return {
		address: ipMatch[1],
		netmask: ipMatch[3] ? prefixToNetmask(ipMatch[3]) : ''
	};
}

function readManagedWanRole() {
	let role = trimSafe(readCommandOutput(`uci -q get chester.network_defaults.wan_role 2>/dev/null`));

	if (role)
		return role;

	if (trimSafe(readCommandOutput(`uci -q get network.wan 2>/dev/null`)))
		return 'wan';

	return '';
}

function readManagedWanDevice(role) {
	let optionalDevice = trimSafe(readCommandOutput(`uci -q get chester.network_defaults.optional_wan 2>/dev/null`));

	if (optionalDevice)
		return optionalDevice;

	let device = trimSafe(readCommandOutput(`uci -q get network.${role}.device 2>/dev/null`));

	if (device)
		return device;

	return trimSafe(readCommandOutput(`uci -q get network.${role}.ifname 2>/dev/null`));
}

function readManagedWanConfig() {
	let role = readManagedWanRole();
	let device = role ? readManagedWanDevice(role) : '';
	let rawIpaddr = role ? (readCommandOutput(`uci -q get network.${role}.ipaddr 2>/dev/null`) || readCommandOutput(`uci -q get network.${role}.ip4addr 2>/dev/null`) || '') : '';
	let parsedIp = parseIpv4Value(rawIpaddr);
	let dns = role ? trimSafe(readCommandOutput(`uci -q get network.${role}.dns 2>/dev/null`)) : '';

	return {
		role: role,
		device: device,
		optional_wan_mode: trimSafe(readCommandOutput(`uci -q get chester.network_defaults.optional_wan_mode 2>/dev/null`) || 'wan') == 'lan' ? 'lan' : 'wan',
		proto: role ? trimSafe(readCommandOutput(`uci -q get network.${role}.proto 2>/dev/null`) || 'dhcp') : 'dhcp',
		username: role ? trimSafe(readCommandOutput(`uci -q get network.${role}.username 2>/dev/null`)) : '',
		password: role ? trimSafe(readCommandOutput(`uci -q get network.${role}.password 2>/dev/null`)) : '',
		ipaddr: parsedIp.address,
		netmask: role ? trimSafe(readCommandOutput(`uci -q get network.${role}.netmask 2>/dev/null`)) || parsedIp.netmask : '',
		gateway: role ? trimSafe(readCommandOutput(`uci -q get network.${role}.gateway 2>/dev/null`)) : '',
		dns: dns
	};
}

function findModemSections() {
	let sections = [];
	let output = readCommandOutput(`uci -q show qmodem 2>/dev/null`);

	if (!output)
		return sections;

	for (let line in split(output, /\n+/)) {
		let modemMatch = match(line, /^qmodem\.([^.=]+)=modem-device$/);
		if (!modemMatch)
			continue;

		let name = modemMatch[1];
		let disabled = trimSafe(readCommandOutput(`uci -q get qmodem.${name}.disabled 2>/dev/null`));
		let state = trimSafe(readCommandOutput(`uci -q get qmodem.${name}.state 2>/dev/null`));

		if (disabled == '1' || state == 'disabled')
			continue;

		push(sections, name);
	}

	return sections;
}

function firstApSection(radioName) {
	let output = readCommandOutput(`uci -q show wireless 2>/dev/null`);
	if (!output)
		return null;

	let current = null;
	let currentType = null;
	let currentDevice = null;
	let currentMode = null;

	for (let line in split(output, /\n+/)) {
		let sectionMatch = match(line, /^wireless\.([^.=]+)=(.+)$/);
		if (sectionMatch) {
			current = sectionMatch[1];
			currentType = sectionMatch[2];
			currentDevice = null;
			currentMode = null;
			continue;
		}

		let optionMatch = match(line, /^wireless\.([^.=]+)\.([^=]+)=(.*)$/);
		if (!optionMatch)
			continue;

		if (optionMatch[1] != current)
			continue;

		let key = optionMatch[2];
		let value = trimSafe(replace(optionMatch[3], /^'|'$/, ''));

		if (key == 'device')
			currentDevice = value;
		else if (key == 'mode')
			currentMode = value;

		if (currentType == 'wifi-iface' && currentDevice == radioName && currentMode == 'ap')
			return current;
	}

	return null;
}

function radioBandLabel(radioName, runtimeBand) {
	let band = trimSafe(runtimeBand || readCommandOutput(`uci -q get wireless.${radioName}.band 2>/dev/null`) || '');
	let lowerBand = trimSafe(band);

	switch (lowerBand) {
	case '2g':
		return '2.4 GHz';
	case '5g':
		return '5 GHz';
	case '6g':
		return '6 GHz';
	default:
		if (match(radioName, /^radio0|2g/i))
			return '2.4 GHz';
		if (match(radioName, /^radio1|5g/i))
			return '5 GHz';
		return radioName;
	}
}

function readWirelessRadios() {
	let radios = [];
	let ifaceSections = readCommandOutput("uci -q show wireless 2>/dev/null | sed -n 's/^wireless\\.\\([^.=]*\\)=wifi-iface$/\\1/p'");

	for (let section in split(ifaceSections || '', /\n+/)) {
		section = trimSafe(section);
		if (!section)
			continue;

		let mode = trimSafe(readCommandOutput(`uci -q get wireless.${section}.mode 2>/dev/null`));
		let radioName = trimSafe(readCommandOutput(`uci -q get wireless.${section}.device 2>/dev/null`));

		if (mode != 'ap' || !radioName)
			continue;

		push(radios, {
			name: radioName,
			section: section,
			band_label: radioBandLabel(radioName, null),
			ssid: trimSafe(readCommandOutput(`uci -q get wireless.${section}.ssid 2>/dev/null`)),
			encryption: trimSafe(readCommandOutput(`uci -q get wireless.${section}.encryption 2>/dev/null`) || 'psk2'),
			key: trimSafe(readCommandOutput(`uci -q get wireless.${section}.key 2>/dev/null`)),
			enabled: trimSafe(readCommandOutput(`uci -q get wireless.${section}.disabled 2>/dev/null`)) != '1'
		});
	}

	return radios;
}

function validateWifiEntries(radios) {
	if (type(radios) != 'array' || !length(radios))
		return 'no manageable wireless interfaces were provided';

	for (let radio in radios) {
		let section = trimSafe(radio.section);
		let ssid = trimSafe(radio.ssid);
		let encryption = trimSafe(radio.encryption || 'psk2');
		let key = radio.key || '';

		if (!section || !ssid || !validEncryption(encryption))
			return 'invalid wireless setup payload';

		if (encryption != 'none' && encryption != 'open' && length(key) < 8)
			return 'wireless password must be at least 8 characters long';
	}

	return null;
}

function applyNetworkConfig(network) {
	let proto = trimSafe(network.proto || 'dhcp');
	let optionalWanMode = trimSafe(network.optional_wan_mode || network.mode || 'wan') == 'lan' ? 'lan' : 'wan';
	let wanRole = trimSafe(network.wan_role || readManagedWanRole());
	let wanDevice = trimSafe(network.wan_device || readManagedWanDevice(wanRole));

	if (!validProtocol(proto))
		return { result: false, code: -1, message: 'invalid protocol' };

	if (!wanRole || !wanDevice)
		return { result: false, code: -1, message: 'no manageable physical WAN port was found' };

	let commands = [
		'set -e',
		`wan_role=${quoteArg(wanRole)}`,
		`wan_device=${quoteArg(wanDevice)}`,
		`lan_device=$(uci -q get network.lan.device 2>/dev/null || true); lan_device=\${lan_device%% *}; [ -n "$lan_device" ] || lan_device=br-lan`,
		`uci -q set chester.network_defaults=network`,
		`uci -q set chester.network_defaults.wan_role=${quoteArg(wanRole)}`,
		`uci -q set chester.network_defaults.wan_device=${quoteArg(wanDevice)}`,
		`uci -q set chester.network_defaults.optional_wan=${quoteArg(wanDevice)}`,
		`uci -q set chester.network_defaults.optional_wan_mode=${quoteArg(optionalWanMode)}`,
		`uci -q set network.${wanRole}.device=${quoteArg(wanDevice)}`,
		`uci -q set network.${wanRole}.proto=${quoteArg(proto)}`,
		`uci -q delete network.${wanRole}.username >/dev/null 2>&1 || true`,
		`uci -q delete network.${wanRole}.password >/dev/null 2>&1 || true`,
		`uci -q delete network.${wanRole}.ipaddr >/dev/null 2>&1 || true`,
		`uci -q delete network.${wanRole}.netmask >/dev/null 2>&1 || true`,
		`uci -q delete network.${wanRole}.gateway >/dev/null 2>&1 || true`,
		`uci -q delete network.${wanRole}.dns >/dev/null 2>&1 || true`,
		`if [ ${quoteArg(optionalWanMode)} = 'wan' ]; then for sid in $(uci show network 2>/dev/null | sed -n "s/^network\\.\\([^.=]*\\)=device$/\\1/p"); do ` +
			`[ "$(uci -q get network.$sid.name 2>/dev/null)" = "$lan_device" ] || continue; ` +
			`ports=$(uci -q get network.$sid.ports 2>/dev/null || true); ` +
			`[ -n "$ports" ] || continue; ` +
			`keep=""; for port in $ports; do if [ "$port" != "$wan_device" ]; then [ -n "$keep" ] && keep="$keep "; keep="$keep$port"; fi; done; ` +
			`uci -q delete network.$sid.ports >/dev/null 2>&1 || true; for port in $keep; do uci -q add_list network.$sid.ports="$port"; done; ` +
		`done; fi`,
		`lan_ifname=$(uci -q get network.lan.ifname 2>/dev/null || true); ` +
		`if [ ${quoteArg(optionalWanMode)} = 'wan' ] && [ -n "$lan_ifname" ]; then ` +
			`keep=""; for port in $lan_ifname; do if [ "$port" != "$wan_device" ]; then [ -n "$keep" ] && keep="$keep "; keep="$keep$port"; fi; done; ` +
			`uci -q set network.lan.ifname="$keep"; ` +
		`fi`
	];

	if (proto == 'pppoe') {
		push(commands, `uci -q set network.${wanRole}.username=${quoteArg(trimSafe(network.username))}`);
		push(commands, `uci -q set network.${wanRole}.password=${quoteArg(network.password || '')}`);
	}
	else if (proto == 'static') {
		push(commands, `uci -q set network.${wanRole}.ipaddr=${quoteArg(trimSafe(network.ipaddr))}`);
		push(commands, `uci -q set network.${wanRole}.netmask=${quoteArg(trimSafe(network.netmask))}`);
		push(commands, `uci -q set network.${wanRole}.gateway=${quoteArg(trimSafe(network.gateway))}`);

		let dns = trimSafe(network.dns);
		if (dns) {
			push(commands, `dns_list=${quoteArg(dns)}`);
			push(commands, `for dns in $dns_list; do uci -q add_list network.${wanRole}.dns="$dns"; done`);
		}
	}

	if (optionalWanMode == 'lan') {
		push(commands,
			`bridge_sid=$(uci show network 2>/dev/null | sed -n "s/^network\\.\\([^.=]*\\)=device$/\\1/p" | while read sid; do [ "$(uci -q get network.$sid.name 2>/dev/null)" = "$lan_device" ] && { echo "$sid"; break; }; done); ` +
			`if [ -n "$bridge_sid" ]; then ` +
				`ports=$(uci -q get network.$bridge_sid.ports 2>/dev/null || true); ` +
				`lan_ifname=$(uci -q get network.lan.ifname 2>/dev/null || true); ` +
				`for port in $lan_ifname; do [ "$port" = "$lan_device" ] && continue; found=0; for existing in $ports; do [ "$existing" = "$port" ] && found=1; done; if [ "$found" != '1' ]; then [ -n "$ports" ] && ports="$ports "; ports="$ports$port"; fi; done; ` +
				`found=0; keep=""; for port in $ports; do [ "$port" = "$wan_device" ] && found=1; [ -n "$keep" ] && keep="$keep "; keep="$keep$port"; done; ` +
				`if [ "$found" != '1' ]; then [ -n "$keep" ] && keep="$keep "; keep="$keep$wan_device"; fi; ` +
				`uci -q delete network.$bridge_sid.ports >/dev/null 2>&1 || true; for port in $keep; do uci -q add_list network.$bridge_sid.ports="$port"; done; ` +
			`else ` +
				`lan_ifname=$(uci -q get network.lan.ifname 2>/dev/null || true); ` +
				`found=0; keep=""; for port in $lan_ifname; do [ "$port" = "$wan_device" ] && found=1; [ -n "$keep" ] && keep="$keep "; keep="$keep$port"; done; ` +
				`if [ "$found" != '1' ]; then [ -n "$keep" ] && keep="$keep "; keep="$keep$wan_device"; fi; ` +
				`uci -q set network.lan.ifname="$keep"; ` +
			`fi`,
			`uci -q set network.${wanRole}.disabled='1'`,
			`zone_sid=$(uci show firewall 2>/dev/null | sed -n "s/^firewall\\.\\([^.=]*\\)=zone$/\\1/p" | while read sid; do [ "$(uci -q get firewall.$sid.name 2>/dev/null)" = "wan" ] && { echo "$sid"; break; }; done); ` +
			`if [ -n "$zone_sid" ]; then ` +
				`networks=$(uci -q get firewall.$zone_sid.network 2>/dev/null || true); keep=""; ` +
				`for net in $networks; do [ "$net" = "$wan_role" ] && continue; [ -n "$keep" ] && keep="$keep "; keep="$keep$net"; done; ` +
				`if [ -n "$keep" ]; then uci -q set firewall.$zone_sid.network="$keep"; else uci -q delete firewall.$zone_sid.network >/dev/null 2>&1 || true; fi; ` +
			`fi`
		);
	}
	else {
		push(commands, `uci -q delete network.${wanRole}.disabled >/dev/null 2>&1 || true`);
		push(commands,
		`zone_sid=$(uci show firewall 2>/dev/null | sed -n "s/^firewall\\.\\([^.=]*\\)=zone$/\\1/p" | while read sid; do [ "$(uci -q get firewall.$sid.name 2>/dev/null)" = "wan" ] && { echo "$sid"; break; }; done); ` +
		`if [ -z "$zone_sid" ]; then ` +
			`zone_sid=$(uci add firewall zone); ` +
			`uci -q set firewall.$zone_sid.name='wan'; ` +
			`uci -q set firewall.$zone_sid.input='REJECT'; ` +
			`uci -q set firewall.$zone_sid.output='ACCEPT'; ` +
			`uci -q set firewall.$zone_sid.forward='DROP'; ` +
			`uci -q set firewall.$zone_sid.masq='1'; ` +
			`uci -q set firewall.$zone_sid.mtu_fix='1'; ` +
		`fi`,
		`networks=$(uci -q get firewall.$zone_sid.network 2>/dev/null || true); ` +
		`found=0; keep=""; ` +
		`for net in $networks; do ` +
			`[ "$net" = "$wan_role" ] && found=1; ` +
			`[ -n "$keep" ] && keep="$keep "; ` +
			`keep="$keep$net"; ` +
		`done; ` +
		`if [ "$found" != '1' ]; then [ -n "$keep" ] && keep="$keep "; keep="$keep$wan_role"; fi; ` +
		`uci -q set firewall.$zone_sid.network="$keep"`,
		`has_forward=0; ` +
		`for sid in $(uci show firewall 2>/dev/null | sed -n "s/^firewall\\.\\([^.=]*\\)=forwarding$/\\1/p"); do ` +
			`[ "$(uci -q get firewall.$sid.src 2>/dev/null)" = 'lan' ] || continue; ` +
			`[ "$(uci -q get firewall.$sid.dest 2>/dev/null)" = 'wan' ] || continue; ` +
			`has_forward=1; break; ` +
		`done; ` +
		`if [ "$has_forward" != '1' ]; then ` +
			`sid=$(uci add firewall forwarding); ` +
			`uci -q set firewall.$sid.src='lan'; ` +
			`uci -q set firewall.$sid.dest='wan'; ` +
		`fi`
		);
	}

	push(commands, 'uci -q commit chester');
	push(commands, 'uci -q commit network');
	push(commands, 'uci -q commit firewall');

	let result = runCommand(join('; ', commands));
	return { result: result.result, code: result.code, message: result.result ? null : 'failed to persist setup network state' };
}

function applyWifiConfig(wifi, radios) {
	let linked = wifi.linked_bands === true;
	let validation = validateWifiEntries(radios);

	if (validation)
		return { result: false, code: -1, message: validation };

	let commands = [
		'set -e',
		'uci -q set chester.wifi_defaults=wifi',
		`uci -q set chester.wifi_defaults.linked_bands=${quoteArg(linked ? '1' : '0')}`
	];

	for (let radio in radios) {
		let section = trimSafe(radio.section);
		let ssid = trimSafe(radio.ssid);
		let encryption = trimSafe(radio.encryption || 'psk2');
		let key = radio.key || '';

		push(commands, `uci -q set wireless.${section}.disabled=${quoteArg('0')}`);
		push(commands, `uci -q set wireless.${section}.ssid=${quoteArg(ssid)}`);
		push(commands, `uci -q set wireless.${section}.encryption=${quoteArg(encryption)}`);

		if (encryption == 'none' || encryption == 'open')
			push(commands, `uci -q delete wireless.${section}.key >/dev/null 2>&1 || true`);
		else
			push(commands, `uci -q set wireless.${section}.key=${quoteArg(key)}`);
	}

	push(commands, 'uci -q commit chester');
	push(commands, 'uci -q commit wireless');

	let result = runCommand(join('; ', commands));
	return { result: result.result, code: result.code, message: result.result ? null : 'failed to persist setup wifi state' };
}

function applyAdminConfig(admin) {
	if (admin?.skipped === true)
		return { result: true, skipped: true };

	let password = trimSafe(admin?.password);

	if (!password)
		return { result: true, skipped: true };

	if (length(password) < 5) {
		return {
			result: false,
			code: -1,
			message: 'administrator password must be at least 5 characters long'
		};
	}

	let result = runCommand(`(echo ${quoteArg(password)}; sleep 1; echo ${quoteArg(password)}) | passwd root >/dev/null 2>&1`);
	return {
		result: result.result,
		code: result.code,
		message: result.result ? null : 'failed to update administrator password'
	};
}

function scheduleRuntimeReload(reloadNetwork, reloadWifi) {
	let commands = [ 'sleep 1' ];

	if (reloadNetwork) {
		push(commands, '/etc/init.d/chester-optional-wan reload >/dev/null 2>&1 || true');
		push(commands, '/etc/init.d/network reload >/dev/null 2>&1 || /etc/init.d/network restart >/dev/null 2>&1 || true');
		push(commands, '/etc/init.d/firewall reload >/dev/null 2>&1 || true');
	}

	if (reloadWifi)
		push(commands, 'wifi reload >/dev/null 2>&1 || true');

	let result = runCommand(`(${join('; ', commands)}) >/dev/null 2>&1 & true`);
	return {
		result: result.result,
		code: result.code
	};
}

function buildSetupContext() {
	if (setupCompleted())
		return setupForbiddenResult();

	return {
		result: true,
		completed: false,
		wizard: {
			completed: false,
			skipped_network: trimSafe(readCommandOutput(`uci -q get chester.setup.skipped_network 2>/dev/null`) || '0') == '1',
			skipped_wifi: trimSafe(readCommandOutput(`uci -q get chester.setup.skipped_wifi 2>/dev/null`) || '0') == '1',
			skipped_admin: trimSafe(readCommandOutput(`uci -q get chester.setup.skipped_admin 2>/dev/null`) || '0') == '1'
		}
	};
}

function buildNetworkContext() {
	if (setupCompleted())
		return setupForbiddenResult();

	let wan = readManagedWanConfig();
	let wanStatusJson = wan.device ? readCommandOutput(`ubus call network.device status ${quoteArg(`{"name":"${wan.device}"}`)} 2>/dev/null`) : null;

	return {
		result: true,
		wan: {
			role: wan.role,
			device: wan.device,
			exists: wan.role != '' && trimSafe(readCommandOutput(`uci -q get network.${wan.role} 2>/dev/null`)) != '',
			optional_wan_mode: wan.optional_wan_mode,
			proto: wan.proto,
			username: wan.username,
			password: wan.password,
			ipaddr: wan.ipaddr,
			netmask: wan.netmask,
			gateway: wan.gateway,
			dns: wan.dns,
			status: parseJsonSafe(wanStatusJson, {})
		}
	};
}

function buildWifiContext() {
	if (setupCompleted())
		return setupForbiddenResult();

	return {
		result: true,
		wifi: {
			linked_bands: trimSafe(readCommandOutput(`uci -q get chester.wifi_defaults.linked_bands 2>/dev/null`) || '1') != '0',
			radios: readWirelessRadios()
		}
	};
}

function buildModemContext() {
	if (setupCompleted())
		return setupForbiddenResult();

	let modemSections = findModemSections();
	let fallbackModem = length(modemSections) ? modemSections[0] : null;
	let fallbackSim = {};
	let fallbackSimStatus = '';
	let sawAvailableModem = false;

	for (let modem in modemSections) {
		if (!isModemAvailable(modem))
			continue;

		sawAvailableModem = true;

		let cpin = readCpinInfo(modem);
		let simStatus = cpin.status;
		let modemSim = {
			modem_info: [
				{
					key: 'SIM Status',
					value: simStatus,
					full_name: 'SIM Status',
					type: 'plain_text',
					class: 'SIM Information',
					class_origin: 'SIM Information'
				}
			]
		};

		if (!fallbackSimStatus) {
			fallbackModem = modem;
			fallbackSim = modemSim;
			fallbackSimStatus = simStatus;
		}

		if (cpin.present !== true)
			continue;

		return {
			result: true,
			modem: {
				section: modem,
				sim_present: true,
				sim_status: simStatus,
				sim: modemSim,
				status: readConnectStatus(modem)
			}
		};
	}

	return {
		result: true,
		modem: {
			section: sawAvailableModem ? fallbackModem : null,
			sim_present: false,
			sim_status: fallbackSimStatus,
			sim: fallbackSim,
			status: {}
		}
	};
}

function applySetupWizardConfig(configJson) {
	if (setupCompleted())
		return setupForbiddenResult();

	let parsed = null;

	try {
		parsed = json(configJson || '{}');
	}
	catch (err) {
		return {
			result: false,
			code: -1,
			message: 'invalid config json'
		};
	}

	if (type(parsed) != 'object') {
		return {
			result: false,
			code: -1,
			message: 'invalid config payload'
		};
	}

	let wizard = parsed.wizard || {};
	let network = parsed.network || {};
	let wifi = parsed.wifi || {};
	let admin = parsed.admin || {};
	let radios = wifi.radios || [];
	let skippedNetwork = wizard.skipped_network === true;
	let skippedWifi = wizard.skipped_wifi === true || !length(radios);
	let skippedAdmin = wizard.skipped_admin === true;

	if (!skippedNetwork) {
		let networkResult = applyNetworkConfig(network);
		if (!networkResult.result)
			return networkResult;
	}

	if (!skippedWifi) {
		let wifiResult = applyWifiConfig(wifi, radios);
		if (!wifiResult.result)
			return wifiResult;
	}

	if (!skippedAdmin) {
		let adminResult = applyAdminConfig(admin);
		if (!adminResult.result)
			return adminResult;
	}

	let wizardResult = persistWizardState(true, skippedNetwork, skippedWifi, skippedAdmin);
	if (!wizardResult.result)
		return wizardResult;

	let applyResult = scheduleRuntimeReload(!skippedNetwork, !skippedWifi);
	if (!applyResult.result) {
		return {
			result: false,
			code: applyResult.code,
			message: 'failed to schedule setup wizard configuration apply'
		};
	}

	return {
		result: true,
		completed: true,
		skipped_network: skippedNetwork,
		skipped_wifi: skippedWifi,
		skipped_admin: skippedAdmin
	};
}

const methods = {
	get_setup_wizard_context: {
		call: function() {
			try {
				return buildSetupContext();
			}
			catch (err) {
				return { result: false, code: -1, message: err?.message || `${err}` };
			}
		}
	},
	get_setup_wizard_network_context: {
		call: function() {
			try {
				return buildNetworkContext();
			}
			catch (err) {
				return { result: false, code: -1, message: err?.message || `${err}` };
			}
		}
	},
	get_setup_wizard_wifi_context: {
		call: function() {
			try {
				return buildWifiContext();
			}
			catch (err) {
				return { result: false, code: -1, message: err?.message || `${err}` };
			}
		}
	},
	get_setup_wizard_modem_context: {
		call: function() {
			try {
				return buildModemContext();
			}
			catch (err) {
				return { result: false, code: -1, message: err?.message || `${err}` };
			}
		}
	},
	apply_setup_wizard_config: {
		args: {
			config_json: 'String'
		},
		call: function(request) {
			try {
				return applySetupWizardConfig(request.args.config_json);
			}
			catch (err) {
				return { result: false, code: -1, message: err?.message || `${err}` };
			}
		}
	},
	skip_setup_wizard: {
		call: function() {
			try {
				let result = persistWizardState(true, true, true, true);
				if (!result.result)
					return result;

				return {
					result: true,
					completed: true,
					skipped_network: true,
					skipped_wifi: true,
					skipped_admin: true
				};
			}
			catch (err) {
				return { result: false, code: -1, message: err?.message || `${err}` };
			}
		}
	}
};

return { chester_setup_wizard: methods };
