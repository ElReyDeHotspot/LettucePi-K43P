#!/bin/sh

LOG_TAG="chester-fan-control"
HWMON_PREFIX="/sys/class/hwmon/"
DEFAULT_INTERVAL=5
DEFAULT_HYSTERESIS=2
LAST_ERROR=

log_error_once() {
	local message

	message="$1"
	if [ "$LAST_ERROR" = "$message" ]; then
		return 0
	fi

	LAST_ERROR="$message"
	logger -t "$LOG_TAG" "$message"
	return 0
}

clear_last_error() {
	LAST_ERROR=
}

normalize_mode() {
	local mode enabled

	mode="$(uci -q get chester.main.fan_mode)"
	case "$mode" in
		0|1|2)
			printf '%s\n' "$mode"
			return 0
			;;
	esac

	enabled="$(uci -q get chester.main.fan_enabled)"
	case "$enabled" in
		0|false|off|disabled)
			printf '0\n'
			;;
		*)
			printf '1\n'
			;;
	esac
}

get_hwmon_target() {
	local hwmon_node

	hwmon_node="$(uci -q get chester.main.hwmon_node)"
	hwmon_node="${hwmon_node%/}"

	case "$hwmon_node" in
		"${HWMON_PREFIX}"*)
			printf '%s/pwm1_enable\n' "$hwmon_node"
			return 0
			;;
	esac

	logger -t "$LOG_TAG" "ignoring invalid hwmon node: $hwmon_node"
	return 1
}

read_temp_node() {
	local temp_node

	temp_node="$(uci -q get chester.main.temp_node)"
	if [ -n "$temp_node" ]; then
		printf '%s\n' "$temp_node"
		return 0
	fi

	temp_node="$(uci -q show chester 2>/dev/null | awk -F"'" '/\\.temp_node=/{ print $2; exit }')"
	if [ -n "$temp_node" ]; then
		printf '%s\n' "$temp_node"
		return 0
	fi

	return 1
}

read_temperature_celsius() {
	local temp_node raw value

	temp_node="$(read_temp_node)"

	if [ -z "$temp_node" ] || [ ! -r "$temp_node" ]; then
		log_error_once "temperature node is not readable: ${temp_node:-<empty>}"
		return 1
	fi

	raw="$(cat "$temp_node" 2>/dev/null)"
	case "$raw" in
		''|*[!0-9]*)
			log_error_once "invalid temperature value: ${raw:-<empty>}"
			return 1
			;;
	esac

	if [ "$raw" -ge 1000 ] 2>/dev/null; then
		value=$((raw / 1000))
	else
		value=$raw
	fi

	printf '%s\n' "$value"
	clear_last_error
	return 0
}

read_threshold() {
	local threshold

	threshold="$(uci -q get chester.main.fan_temp_threshold)"
	case "$threshold" in
		''|*[!0-9]*)
			log_error_once "invalid fan temperature threshold: ${threshold:-<empty>}"
			return 1
			;;
	esac

	if [ "$threshold" -lt 1 ] || [ "$threshold" -gt 150 ]; then
		log_error_once "fan temperature threshold out of range: $threshold"
		return 1
	fi

	printf '%s\n' "$threshold"
	clear_last_error
	return 0
}

write_pwm_value() {
	local target value current

	target="$1"
	value="$2"

	if [ ! -e "$target" ]; then
		logger -t "$LOG_TAG" "target does not exist: $target"
		return 1
	fi

	if [ ! -w "$target" ]; then
		logger -t "$LOG_TAG" "target is not writable: $target"
		return 1
	fi

	current="$(cat "$target" 2>/dev/null)"
	if [ "$current" = "$value" ]; then
		return 0
	fi

	if ! printf '%s\n' "$value" > "$target"; then
		logger -t "$LOG_TAG" "failed to write pwm value $value to: $target"
		return 1
	fi

	return 0
}

write_pwm_duty() {
	local target duty_node current

	target="$1"
	duty_node="${target%_enable}"

	[ "$duty_node" != "$target" ] || return 0
	[ -w "$duty_node" ] || return 0

	current="$(cat "$duty_node" 2>/dev/null)"
	if [ "$current" = "100" ]; then
		return 0
	fi

	if ! printf '100\n' > "$duty_node"; then
		logger -t "$LOG_TAG" "failed to write pwm duty 100 to: $duty_node"
		return 1
	fi

	return 0
}

run_monitor_loop() {
	local interval hysteresis target threshold temperature state off_threshold current

	interval="${1:-$DEFAULT_INTERVAL}"
	hysteresis="${2:-$DEFAULT_HYSTERESIS}"
	state=

	while true; do
		target="$(get_hwmon_target)" || {
			log_error_once "unable to resolve pwm target"
			sleep "$interval"
			continue
		}
		threshold="$(read_threshold)" || {
			write_pwm_value "$target" 0 >/dev/null 2>&1 || true
			sleep "$interval"
			continue
		}
		off_threshold=$((threshold - hysteresis))
		[ "$off_threshold" -lt 0 ] && off_threshold=0
		temperature="$(read_temperature_celsius)" || {
			sleep "$interval"
			continue
		}

		if [ "$temperature" -ge "$threshold" ]; then
			state=1
		elif [ -n "$state" ] && [ "$temperature" -lt "$off_threshold" ]; then
			state=0
		elif [ -z "$state" ]; then
			if [ "$temperature" -lt "$off_threshold" ]; then
				state=0
			else
				current="$(cat "$target" 2>/dev/null)"
				case "$current" in
					1) state=1 ;;
					*) state=0 ;;
				esac
			fi
		fi

		if [ -n "$state" ]; then
			if [ "$state" = "1" ]; then
				write_pwm_duty "$target" >/dev/null 2>&1 || true
			fi
			write_pwm_value "$target" "$state" >/dev/null 2>&1 || true
		fi

		sleep "$interval"
	done
}

run_monitor_loop "$@"
