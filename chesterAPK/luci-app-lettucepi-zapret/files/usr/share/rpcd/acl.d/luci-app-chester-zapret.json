{
    "luci-app-chester-zapret": {
        "description": "Control the 4K/HD engine and run the streaming test",
        "read": {
            "ubus": {
                "misectel": [
                    "video_engine"
                ]
            },
            "file": {
                "/usr/sbin/chester-zapret status": [
                    "exec"
                ],
                "/usr/sbin/chester-videotest both": [
                    "exec"
                ],
                "/usr/sbin/chester-videotest ab-status": [
                    "exec"
                ],
                "/usr/sbin/chester-zapret install-status": [
                    "exec"
                ]
            },
            "uci": [
                "zapret",
                "chester"
            ]
        },
        "write": {
            "ubus": {
                "misectel": [
                    "set_video_engine"
                ]
            },
            "file": {
                "/usr/sbin/chester-zapret install": [
                    "exec"
                ],
                "/usr/sbin/chester-zapret uninstall": [
                    "exec"
                ],
                "/usr/sbin/chester-videotest ab-start": [
                    "exec"
                ],
                "/usr/sbin/chester-zapret install-start": [
                    "exec"
                ]
            }
        }
    }
}
