#!/bin/sh

STATE=/tmp/lettucepi-speedtest
PID="$STATE/pid"
OUT="$STATE/output.jsonl"
ERR="$STATE/error.log"
DONE="$STATE/done"
FAILED="$STATE/failed"
OOKLA_URL=https://install.speedtest.net/app/cli/ookla-speedtest-1.2.0-linux-aarch64.tgz
OOKLA_SHA256=3953d231da3783e2bf8904b6dd72767c5c6e533e163d3742fd0437affa431bd3
HISTORY=/etc/lettucepi/speedtest-history.jsonl

speedtest_bin() {
	for p in /usr/bin/speedtest /usr/sbin/speedtest /sbin/speedtest; do
		[ -x "$p" ] && { printf '%s\n' "$p"; return 0; }
	done
	return 1
}

is_running() {
	[ -s "$PID" ] && kill -0 "$(cat "$PID" 2>/dev/null)" 2>/dev/null
}

json_string() {
	printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g; s/\t/\\t/g; s/\r/\\r/g; s/\n/\\n/g'
}

record_result() {
	line=
	while IFS= read -r candidate; do
		[ "$(jsonfilter -s "$candidate" -e '@.type' 2>/dev/null)" = result ] && line="$candidate"
	done < "$OUT" 2>/dev/null
	[ -n "$line" ] || return 0
	down="$(jsonfilter -s "$line" -e '@.download.bandwidth' 2>/dev/null)"
	up="$(jsonfilter -s "$line" -e '@.upload.bandwidth' 2>/dev/null)"
	latency="$(jsonfilter -s "$line" -e '@.ping.latency' 2>/dev/null)"
	loss="$(jsonfilter -s "$line" -e '@.packetLoss' 2>/dev/null)"
	isp="$(jsonfilter -s "$line" -e '@.isp' 2>/dev/null)"
	server="$(jsonfilter -s "$line" -e '@.server.name' 2>/dev/null)"
	location="$(jsonfilter -s "$line" -e '@.server.location' 2>/dev/null)"
	url="$(jsonfilter -s "$line" -e '@.result.url' 2>/dev/null)"
	down_mbps="$(awk -v n="${down:-0}" 'BEGIN { printf "%.2f", (n * 8) / 1000000 }')"
	up_mbps="$(awk -v n="${up:-0}" 'BEGIN { printf "%.2f", (n * 8) / 1000000 }')"
	mkdir -p "$(dirname "$HISTORY")"
	printf '{"timestamp":%s,"download_mbps":%s,"upload_mbps":%s,"latency_ms":%s,"packet_loss":%s,"isp":"%s","server":"%s","location":"%s","result_url":"%s"}\n' \
		"$(date +%s)" "$down_mbps" "$up_mbps" "${latency:-0}" "${loss:-0}" \
		"$(json_string "$isp")" "$(json_string "$server")" "$(json_string "$location")" "$(json_string "$url")" >> "$HISTORY"
	tail -n 10 "$HISTORY" > "$HISTORY.tmp" && mv "$HISTORY.tmp" "$HISTORY"
}

history() {
	printf '{"results":['
	first=1
	tail -n 10 "$HISTORY" 2>/dev/null | while IFS= read -r line; do
		[ -n "$line" ] || continue
		[ "$first" = 1 ] || printf ','
		printf '%s' "$line"
		first=0
	done
	printf ']}\n'
}

status() {
	bin="$(speedtest_bin 2>/dev/null || true)"
	installed=false; [ -n "$bin" ] && installed=true
	running=false; is_running && running=true
	phase=idle
	[ "$running" = true ] && phase=running
	[ -e "$DONE" ] && phase=completed
	[ -e "$FAILED" ] && phase=failed
	type=; latency=; down=; up=; loss=; isp=; server=; location=; url=
	while IFS= read -r line; do
		value="$(jsonfilter -s "$line" -e '@.type' 2>/dev/null)"; [ -n "$value" ] && type="$value"
		value="$(jsonfilter -s "$line" -e '@.ping.latency' 2>/dev/null)"; [ -n "$value" ] && latency="$value"
		value="$(jsonfilter -s "$line" -e '@.download.bandwidth' 2>/dev/null)"; [ -n "$value" ] && down="$value"
		value="$(jsonfilter -s "$line" -e '@.upload.bandwidth' 2>/dev/null)"; [ -n "$value" ] && up="$value"
		value="$(jsonfilter -s "$line" -e '@.packetLoss' 2>/dev/null)"; [ -n "$value" ] && loss="$value"
		value="$(jsonfilter -s "$line" -e '@.isp' 2>/dev/null)"; [ -n "$value" ] && isp="$value"
		value="$(jsonfilter -s "$line" -e '@.server.name' 2>/dev/null)"; [ -n "$value" ] && server="$value"
		value="$(jsonfilter -s "$line" -e '@.server.location' 2>/dev/null)"; [ -n "$value" ] && location="$value"
		value="$(jsonfilter -s "$line" -e '@.result.url' 2>/dev/null)"; [ -n "$value" ] && url="$value"
	done < "$OUT" 2>/dev/null
	[ "$type" = result ] && phase=completed
	down_mbps="$(awk -v n="${down:-0}" 'BEGIN { printf "%.2f", (n * 8) / 1000000 }')"
	up_mbps="$(awk -v n="${up:-0}" 'BEGIN { printf "%.2f", (n * 8) / 1000000 }')"
	err="$(tail -n 3 "$ERR" 2>/dev/null)"
	printf '{"installed":%s,"running":%s,"phase":"%s","test_phase":"%s","download_mbps":%s,"upload_mbps":%s,"latency_ms":%s,"packet_loss":%s,"isp":"%s","server":"%s","location":"%s","result_url":"%s","error":"%s"}\n' \
		"$installed" "$running" "$phase" "$(json_string "$type")" "$down_mbps" "$up_mbps" "${latency:-0}" "${loss:-0}" \
		"$(json_string "$isp")" "$(json_string "$server")" "$(json_string "$location")" \
		"$(json_string "$url")" "$(json_string "$err")"
}

case "${1:-status}" in
	install)
		mkdir -p "$STATE/install"
		archive="$STATE/install/ookla-speedtest.tgz"
		rm -f "$archive" "$STATE/install/speedtest"
		if ! curl -fL --proto '=https' --tlsv1.2 --connect-timeout 15 --max-time 120 -o "$archive" "$OOKLA_URL" >"$STATE/install.log" 2>&1; then
			printf '{"ok":false,"error":"download_failed"}\n'; exit 0
		fi
		actual="$(sha256sum "$archive" | awk '{print $1}')"
		if [ "$actual" != "$OOKLA_SHA256" ]; then
			rm -f "$archive"; printf '{"ok":false,"error":"checksum_failed"}\n'; exit 0
		fi
		if ! tar -xzf "$archive" -C "$STATE/install" speedtest >>"$STATE/install.log" 2>&1; then
			printf '{"ok":false,"error":"extract_failed"}\n'; exit 0
		fi
		if ! cp "$STATE/install/speedtest" /usr/bin/speedtest.new || ! chmod 0755 /usr/bin/speedtest.new || ! mv /usr/bin/speedtest.new /usr/bin/speedtest; then
			rm -f /usr/bin/speedtest.new
			printf '{"ok":false,"error":"install_failed"}\n'; exit 0
		fi
		mkdir -p /etc/lettucepi
		printf '%s\n' "$OOKLA_SHA256" > /etc/lettucepi/speedtest-engine-managed
		rm -rf "$STATE/install"
		printf '{"ok":true,"installed":true}\n'
		;;
	start)
		bin="$(speedtest_bin 2>/dev/null || true)"
		[ -n "$bin" ] || { printf '{"ok":false,"error":"official_cli_not_installed"}\n'; exit 0; }
		if is_running; then printf '{"ok":false,"error":"already_running"}\n'; exit 0; fi
		mkdir -p "$STATE"
		rm -f "$OUT" "$ERR" "$DONE" "$FAILED" "$PID"
		(
			if HOME=/root LANG=C "$bin" --accept-license --accept-gdpr --format=jsonl >"$OUT" 2>"$ERR"; then
				record_result
				touch "$DONE"
			else
				touch "$FAILED"
			fi
		) </dev/null >/dev/null 2>&1 &
		echo $! > "$PID"
		printf '{"ok":true,"started":true}\n'
		;;
	cancel)
		if is_running; then kill "$(cat "$PID")" 2>/dev/null || true; fi
		rm -f "$PID"
		printf '{"ok":true}\n'
		;;
	history) history ;;
	status) status ;;
	*) printf '{"ok":false,"error":"invalid_action"}\n' ;;
esac
