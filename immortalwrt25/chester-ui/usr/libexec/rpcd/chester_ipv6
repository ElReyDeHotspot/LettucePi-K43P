#!/bin/sh
. /usr/share/libubox/jshn.sh

wan_zone_index() {
	local index=0 name
	while uci -q get "firewall.@zone[$index]" >/dev/null; do
		name="$(uci -q get "firewall.@zone[$index].name")"
		[ "$name" = "wan" ] && { echo "$index"; return; }
		index=$((index + 1))
	done
	echo 1
}

lan_zone_index() {
	local index=0 name
	while uci -q get "firewall.@zone[$index]" >/dev/null; do
		name="$(uci -q get "firewall.@zone[$index].name")"
		[ "$name" = "lan" ] && { echo "$index"; return; }
		index=$((index + 1))
	done
	echo 0
}

print_status() {
	local upstream lan wan_index lan_index upstream_up upstream_address upstream_prefix lan_address
	local ra dhcpv6 ra_slaac masq6 delegate sourcefilter control_safe enabled
	local lan_global address_method
	upstream="$(ubus call network.interface.pcie0v6 status 2>/dev/null)"
	lan="$(ubus call network.interface.lan status 2>/dev/null)"
	wan_index="$(wan_zone_index)"
	lan_index="$(lan_zone_index)"
	upstream_up="$(printf '%s' "$upstream" | jq -r '.up // false')"
	upstream_address="$(printf '%s' "$upstream" | jq -r '."ipv6-address"[0].address // ""')"
	upstream_prefix="$(printf '%s' "$upstream" | jq -r '."ipv6-prefix"[0] | if . then (.address + "/" + (.mask|tostring)) else "" end')"
	# The GLOBAL address, preferring it over the ULA. br-lan normally carries
	# both, and the global one is what clients actually use as their gateway,
	# so reporting the ULA describes an address nothing is routed through.
	lan_global="$(ip -6 addr show dev br-lan scope global 2>/dev/null | awk '/inet6/{print $2}' | cut -d/ -f1 | grep -v '^f[cd]' | head -1)"
	lan_address="$lan_global"
	[ -n "$lan_address" ] || lan_address="$(printf '%s' "$lan" | jq -r '."ipv6-prefix-assignment"[]? | select(.address | startswith("fd")) | ."local-address".address' | head -1)"
	ra="$(uci -q get dhcp.lan.ra)"
	dhcpv6="$(uci -q get dhcp.lan.dhcpv6)"
	ra_slaac="$(uci -q get dhcp.lan.ra_slaac)"
	masq6="$(uci -q get "firewall.@zone[$wan_index].masq6")"
	delegate="$(uci -q get network.pcie0v6.delegate)"
	sourcefilter="$(uci -q get network.pcie0v6.sourcefilter)"
	control_safe=false
	grep -q 'meta l4proto != ipv6-icmp' /etc/nftables.d/99-reset-ttl-from-br-lan.nft 2>/dev/null && control_safe=true

	# How addresses actually reach clients. DHCPv6 being off is not a fault and
	# must not be shown as one: the shipped default hands out addresses by
	# SLAAC from the router advertisement, and nothing ever listens on udp/547.
	# Reporting only "DHCPv6: Off" on a router whose IPv6 works perfectly reads
	# as breakage, so state the mechanism that is really in use.
	address_method="None"
	if [ "$ra" = server ]; then
		if [ "$dhcpv6" = server ] && [ "$ra_slaac" = 1 ]; then
			address_method="SLAAC and DHCPv6"
		elif [ "$dhcpv6" = server ]; then
			address_method="DHCPv6"
		elif [ "$ra_slaac" = 1 ]; then
			address_method="SLAAC"
		fi
	fi

	# Enabled means observed reality -- the LAN holds a routable address and
	# the router is advertising it -- not a fingerprint of one specific
	# configuration. The previous test additionally demanded DHCPv6, masq6,
	# delegate and sourcefilter, none of which the shipped default sets, so a
	# fully working router reported IPv6 as off.
	#
	# Two ways to be genuinely on. A carrier that delegates a prefix gives the
	# LAN a global address, which is the good case. A carrier that delegates
	# nothing leaves the LAN on its ULA, and the way out is masq6 on the wan
	# zone -- NAT6. That case is working IPv6 as far as a client is concerned,
	# so demanding a global address there would flip the switch back off on
	# exactly the routers that need the toggle most.
	enabled=false
	if [ "$ra" = server ]; then
		[ -n "$lan_global" ] && enabled=true
		[ "$masq6" = 1 ] && [ -n "$lan_address" ] && enabled=true
	fi
	jq -n --argjson enabled "$enabled" --argjson upstream_up "$upstream_up" \
		--arg upstream_address "$upstream_address" --arg upstream_prefix "$upstream_prefix" \
		--arg lan_address "$lan_address" --arg ra "$ra" --arg dhcpv6 "$dhcpv6" \
		--arg address_method "$address_method" \
		--argjson control_safe "$control_safe" \
		'{enabled:$enabled,upstream_up:$upstream_up,upstream_address:$upstream_address,upstream_prefix:$upstream_prefix,lan_address:$lan_address,ra:$ra,dhcpv6:$dhcpv6,address_method:$address_method,control_safe:$control_safe}'
}

set_enabled() {
	local payload enabled wan_index lan_index
	payload="$(cat)"
	json_load "$payload"
	json_get_var enabled enabled
	wan_index="$(wan_zone_index)"
	lan_index="$(lan_zone_index)"
	if [ "$enabled" = 1 ] || [ "$enabled" = true ]; then
		# These two lines used to be delegate=0 and ip6class=local, which is
		# why turning IPv6 ON turned it straight back off.
		#
		# delegate=0 tells netifd not to pass the prefix obtained here to any
		# other interface, so br-lan never received one. ip6class=local then
		# told the LAN to accept only prefixes of class "local", while an
		# upstream publishes its prefix under its own interface name --
		# "pcie0v6" -- so even a delegated prefix was filtered out. The LAN was
		# left holding nothing but its ULA, odhcpd logged "no public prefix on
		# lan" and refused to advertise a default route, and print_status,
		# which decides "enabled" by looking for a global LAN address, quite
		# correctly reported false. The switch flipped back every time.
		#
		# Measured on the bench: with delegate=1 and no ip6class, br-lan picked
		# up 2607:fb91:13a2:18b4::1/64 within seconds and a LAN client reached
		# ip6.me over its own global address.
		uci set network.pcie0v6.delegate=1
		uci set network.pcie0v6.sourcefilter=0
		uci set network.lan.ip6assign=64
		uci -q delete network.lan.ip6class
		uci set dhcp.lan.ra=server
		uci set dhcp.lan.ra_slaac=1
		uci set dhcp.lan.dhcpv6=server
		uci set "firewall.@zone[$lan_index].masq6=0"
		uci set "firewall.@zone[$wan_index].masq6=1"
	else
		uci set dhcp.lan.ra=disabled
		uci set dhcp.lan.dhcpv6=disabled
		uci set "firewall.@zone[$wan_index].masq6=0"
	fi
	uci commit network
	uci commit dhcp
	uci commit firewall
	/etc/init.d/odhcpd restart >/dev/null 2>&1
	/etc/init.d/firewall restart >/dev/null 2>&1
	print_status
}

run_test() {
	local source output ok latency
	# Source selection is the whole test. br-lan holds both a delegated global
	# address and a ULA, and this used to pick the ULA on purpose (/inet6 fd/).
	# A ULA cannot reach the internet -- it is not globally routable, and it
	# does not match the carrier's source-restricted default route -- so the
	# ping failed every single time and the page reported "No IPv6 Connection"
	# on routers whose IPv6 was working perfectly. Measured on the bench: from
	# the ULA, nothing; from the global address, a reply in 39 ms.
	#
	# So: prefer a global address, and if there genuinely is not one, let the
	# kernel choose rather than forcing a source that cannot work.
	source="$(ip -6 addr show dev br-lan scope global 2>/dev/null | awk '/inet6/{print $2}' | cut -d/ -f1 | grep -v '^f[cd]' | head -1)"
	if [ -n "$source" ]; then
		output="$(ping -6 -I "$source" -c 1 -W 3 2606:4700:4700::1111 2>&1)"
	else
		output="$(ping -6 -c 1 -W 3 2606:4700:4700::1111 2>&1)"
	fi
	ok=false
	printf '%s' "$output" | grep -q '1 packets received' && ok=true
	latency="$(printf '%s' "$output" | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' | head -1)"
	jq -n --argjson ok "$ok" --arg latency "$latency" '{ok:$ok,latency_ms:$latency}'
}

case "$1" in
	list)
		echo '{"status":{},"set":{"enabled":"Boolean"},"test":{}}'
	;;
	call)
		case "$2" in
			status) print_status ;;
			set) set_enabled ;;
			test) run_test ;;
		esac
	;;
esac
