#!/bin/sh
. /usr/share/libubox/jshn.sh

wan_zone_index() {
	local index=0 name
	while uci -q get "firewall.@zone[$index]" >/dev/null; do
		name="$(uci -q get "firewall.@zone[$index].name")"
		[ "$name" = "wan" ] && { echo "$index"; return; }
		index=$((index + 1))
	done
	echo 1
}

lan_zone_index() {
	local index=0 name
	while uci -q get "firewall.@zone[$index]" >/dev/null; do
		name="$(uci -q get "firewall.@zone[$index].name")"
		[ "$name" = "lan" ] && { echo "$index"; return; }
		index=$((index + 1))
	done
	echo 0
}

print_status() {
	local upstream lan wan_index lan_index upstream_up upstream_address upstream_prefix lan_address
	local ra dhcpv6 masq6 delegate sourcefilter control_safe enabled
	upstream="$(ubus call network.interface.pcie0v6 status 2>/dev/null)"
	lan="$(ubus call network.interface.lan status 2>/dev/null)"
	wan_index="$(wan_zone_index)"
	lan_index="$(lan_zone_index)"
	upstream_up="$(printf '%s' "$upstream" | jq -r '.up // false')"
	upstream_address="$(printf '%s' "$upstream" | jq -r '."ipv6-address"[0].address // ""')"
	upstream_prefix="$(printf '%s' "$upstream" | jq -r '."ipv6-prefix"[0] | if . then (.address + "/" + (.mask|tostring)) else "" end')"
	lan_address="$(printf '%s' "$lan" | jq -r '."ipv6-prefix-assignment"[]? | select(.address | startswith("fd")) | ."local-address".address' | head -1)"
	ra="$(uci -q get dhcp.lan.ra)"
	dhcpv6="$(uci -q get dhcp.lan.dhcpv6)"
	masq6="$(uci -q get "firewall.@zone[$wan_index].masq6")"
	delegate="$(uci -q get network.pcie0v6.delegate)"
	sourcefilter="$(uci -q get network.pcie0v6.sourcefilter)"
	control_safe=false
	grep -q 'meta l4proto != ipv6-icmp' /etc/nftables.d/99-reset-ttl-from-br-lan.nft 2>/dev/null && control_safe=true
	enabled=false
	[ "$ra" = server ] && [ "$dhcpv6" = server ] && [ "$masq6" = 1 ] && [ "$delegate" = 0 ] && [ "$sourcefilter" = 0 ] && enabled=true
	jq -n --argjson enabled "$enabled" --argjson upstream_up "$upstream_up" \
		--arg upstream_address "$upstream_address" --arg upstream_prefix "$upstream_prefix" \
		--arg lan_address "$lan_address" --arg ra "$ra" --arg dhcpv6 "$dhcpv6" \
		--argjson control_safe "$control_safe" \
		'{enabled:$enabled,upstream_up:$upstream_up,upstream_address:$upstream_address,upstream_prefix:$upstream_prefix,lan_address:$lan_address,ra:$ra,dhcpv6:$dhcpv6,control_safe:$control_safe}'
}

set_enabled() {
	local payload enabled wan_index lan_index
	payload="$(cat)"
	json_load "$payload"
	json_get_var enabled enabled
	wan_index="$(wan_zone_index)"
	lan_index="$(lan_zone_index)"
	if [ "$enabled" = 1 ] || [ "$enabled" = true ]; then
		uci set network.pcie0v6.delegate=0
		uci set network.pcie0v6.sourcefilter=0
		uci set network.lan.ip6assign=64
		uci set network.lan.ip6class=local
		uci set dhcp.lan.ra=server
		uci set dhcp.lan.ra_slaac=1
		uci set dhcp.lan.dhcpv6=server
		uci set "firewall.@zone[$lan_index].masq6=0"
		uci set "firewall.@zone[$wan_index].masq6=1"
	else
		uci set dhcp.lan.ra=disabled
		uci set dhcp.lan.dhcpv6=disabled
		uci set "firewall.@zone[$wan_index].masq6=0"
	fi
	uci commit network
	uci commit dhcp
	uci commit firewall
	/etc/init.d/odhcpd restart >/dev/null 2>&1
	/etc/init.d/firewall restart >/dev/null 2>&1
	print_status
}

run_test() {
	local source output ok latency
	source="$(ip -6 addr show dev br-lan scope global | awk '/inet6 fd/{print $2}' | cut -d/ -f1 | head -1)"
	[ -n "$source" ] && output="$(ping -6 -I "$source" -c 1 -W 3 2606:4700:4700::1111 2>&1)" || output=""
	ok=false
	printf '%s' "$output" | grep -q '1 packets received' && ok=true
	latency="$(printf '%s' "$output" | sed -n 's/.*time=\([0-9.]*\) ms.*/\1/p' | head -1)"
	jq -n --argjson ok "$ok" --arg latency "$latency" '{ok:$ok,latency_ms:$latency}'
}

case "$1" in
	list)
		echo '{"status":{},"set":{"enabled":"Boolean"},"test":{}}'
	;;
	call)
		case "$2" in
			status) print_status ;;
			set) set_enabled ;;
			test) run_test ;;
		esac
	;;
esac
