#!/usr/bin/ucode
'use strict';
import {popen} from 'fs';
function q(s){return "'"+replace(s||'',"'","'\\''")+"'";}
function run(action,input){if(length(input||'')>8192)return {success:false,error:'IPv6 settings are too large.'};let p=popen('/usr/libexec/chester-ipv6 '+action+(input?' '+q(input):''),'r');if(!p)return {success:false,error:'IPv6 service unavailable.'};let text=p.read(65536);p.close();try{return json(text);}catch(e){return {success:false,error:'IPv6 service returned an invalid response.'};}}
return {'chester.ipv6':{
 status:{call:()=>run('status')},
 save:{args:{settings:'String'},call:r=>run('save',r.args.settings)},
 test:{call:()=>run('test')}
}};
