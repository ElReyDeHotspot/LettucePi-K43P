{
  "luci-app-chester-update": {
    "description": "Check for and install Chester firmware updates",
    "read": {
      "file": {
        "/usr/sbin/chester-update status": [
          "exec"
        ],
        "/usr/sbin/chester-update status-local": [
          "exec"
        ],
        "/usr/sbin/chester-update job-status": [
          "exec"
        ],
        "/usr/libexec/chester-home-update": [
          "exec"
        ],
        "/usr/sbin/chester-update firmware-status": [
          "exec"
        ]
      }
    },
    "write": {
      "file": {
        "/usr/sbin/chester-update install": [
          "exec"
        ],
        "/usr/sbin/chester-update install *": [
          "exec"
        ],
        "/usr/sbin/chester-update firmware-install": [
          "exec"
        ],
        "/usr/sbin/chester-update firmware-install *": [
          "exec"
        ]
      }
    }
  }
}
