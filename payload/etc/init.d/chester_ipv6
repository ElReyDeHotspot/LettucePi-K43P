#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
 ubus -t 2 call network.interface.lan status >/dev/null 2>&1 || return 0
 /usr/libexec/chester-ipv6 recover >/dev/null
 /usr/libexec/chester-ipv6 bootstrap >/dev/null
 mode=$(uci -q get chester_ipv6.main.mode)
 [ -z "$mode" ] || [ "$mode" = auto ] || [ "$(uci -q get chester_ipv6.main.recovery)" = 1 ] || return 0
 [ "$(uci -q get chester_ipv6.main.mode)" != disabled ] || return 0
 procd_open_instance
 procd_set_param command /usr/libexec/chester-ipv6-watch
 procd_set_param respawn 3600 5 3
 procd_close_instance
}
