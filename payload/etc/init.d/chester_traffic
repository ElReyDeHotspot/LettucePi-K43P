#!/bin/sh /etc/rc.common
START=98
STOP=10
USE_PROCD=1
start_service() {
    [ -f /etc/chester-traffic.installed ] && [ -x /usr/libexec/chester-traffic ] || return 0
    procd_open_instance
    procd_set_param command /usr/libexec/chester-traffic serve
    procd_set_param respawn 3600 5 5
    procd_set_param nice 10
    procd_set_param limits core=0
    procd_close_instance
}
